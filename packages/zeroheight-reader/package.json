{
  "name": "@dsaf/zeroheight-reader",
  "version": "0.1.0",
  "description": "DSAF zeroheight-export reader that scores A.3 documentation and A.5 tooling evidence from local HTML exports.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "dsaf-zeroheight-reader": "./src/cli.js"
  },
  "files": [
    "src/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node src/cli.js tests/fixtures/zeroheight-export-sample"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "cyberskill": {
    "budgets": {
      "source": 45000,
      "gzip": 12000
    }
  },
  "engines": {
    "node": ">=24"
  }
}
