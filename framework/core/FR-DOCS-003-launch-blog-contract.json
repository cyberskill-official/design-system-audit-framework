{
  "schema_version": "2026-05-18",
  "fr_id": "FR-DOCS-003",
  "status": "strict-audit-contract-mocked-dependency",
  "observability": {
    "audit_output": "outputs/_audit/launch-blog-contract.json",
    "correlation_key": "fr_id + file + rule_id",
    "events": [
      "blog_markdown_checked",
      "rendered_html_checked",
      "og_asset_checked",
      "no_funnel_copy_checked",
      "mock_deploy_checked",
      "strict_audit_recorded"
    ]
  },
  "edge_case_matrix": [
    {
      "case": "Null post",
      "failure_vector": "Launch blog markdown is missing.",
      "expected_handling": "Fail the contract and block launch handoff."
    },
    {
      "case": "Malformed frontmatter",
      "failure_vector": "Canonical URL, date, or OG image is absent.",
      "expected_handling": "Fail frontmatter checks."
    },
    {
      "case": "Candid section removed",
      "failure_vector": "Post drifts into announcement/authority framing.",
      "expected_handling": "Fail required section and banned phrase checks."
    },
    {
      "case": "Named quote fabricated",
      "failure_vector": "Post publishes endorsements before consent rows exist.",
      "expected_handling": "Fail unless the approved quote contract is updated; current state requires no-fabricated-quotes note."
    },
    {
      "case": "OG image wrong size",
      "failure_vector": "Social unfurls clip or render blank.",
      "expected_handling": "Fail PNG dimension check."
    },
    {
      "case": "Production route unavailable",
      "failure_vector": "Vercel deploy or cache state requires operator credentials.",
      "expected_handling": "Use mocked deploy verification and keep repo-rendered routes strict."
    }
  ],
  "files": {
    "post_markdown": "internal/landing/blog/launch-2026.md",
    "blog_index": "internal/landing/blog/index.md",
    "rendered_html": "internal/landing/blog/launch-2026/index.html",
    "rendered_flat_html": "internal/landing/blog/launch-2026.html",
    "og_png": "framework/assets/og/launch-2026-1200x630.png",
    "og_svg": "framework/assets/og/launch-2026-1200x630.svg",
    "deploy_og_png": "internal/landing/assets/og/launch-2026-1200x630.png"
  },
  "frontmatter": {
    "title_max_chars": 80,
    "required": {
      "slug": "launch-2026",
      "date": "2026-05-18",
      "canonical": "https://audit.cyberskill.world/blog/launch-2026",
      "og_image": "https://audit.cyberskill.world/assets/og/launch-2026-1200x630.png"
    }
  },
  "body": {
    "min_words": 1200,
    "max_words": 3500,
    "required_headings": [
      "# We built DSAF because design-system audits kept becoming taste arguments",
      "## What DSAF is",
      "## Why we built it",
      "## What we got wrong first",
      "## What we got right, I think",
      "## Who this is for",
      "## What feedback would help",
      "## What's next",
      "## ChangeLog"
    ],
    "required_strings": [
      "125-criterion",
      "DSAF-25 Core",
      "no-silent-regression",
      "L3 until independent verification exists",
      "geography headwind is real",
      "named endorsement quotes",
      "No quote appears until the exact wording and attribution are approved in writing",
      "github.com/cyberskill-official/design-system-audit-framework",
      "Disclosure: I run CyberSkill"
    ],
    "required_images": [
      "/assets/dsaf-l0-l5-ladder.svg",
      "/assets/dsaf-radar.svg"
    ],
    "forbidden_patterns": [
      "Definitive Guide",
      "industry[- ]?leading",
      "top tier",
      "Talk to a certified",
      "Schedule (a|your) demo",
      "Book (a|your) call",
      "84\\.6",
      "<form",
      "email-capture"
    ]
  },
  "rendered_html": {
    "required_strings": [
      "<meta property=\"og:type\" content=\"article\">",
      "<meta name=\"twitter:card\" content=\"summary_large_image\">",
      "<link rel=\"canonical\" href=\"https://audit.cyberskill.world/blog/launch-2026\">",
      "<meta property=\"og:image\" content=\"https://audit.cyberskill.world/assets/og/launch-2026-1200x630.png\">",
      "<img src=\"/assets/dsaf-l0-l5-ladder.svg\"",
      "<img src=\"/assets/dsaf-radar.svg\"",
      "Show HN discussion link: pending operator submission."
    ]
  },
  "og_png": {
    "width": 1200,
    "height": 630,
    "min_bytes": 5000
  },
  "required_package_scripts": {
    "contract:launch-blog": "node framework/scripts/checks/check-launch-blog-contract.mjs",
    "test:launch-blog-contract": "node --test framework/scripts/test/check-launch-blog-contract.test.mjs"
  },
  "deploy_mock_contract": {
    "endpoint": "POST /mock/launch-blog-deploy-verification",
    "request": {
      "fr_id": "FR-DOCS-003",
      "canonical_url": "https://audit.cyberskill.world/blog/launch-2026",
      "requires_production_deploy": true,
      "approved_quote_count": 0,
      "blocked_reason": "Production deploy state and named reviewer quotes require operator action."
    },
    "response": {
      "status_code": 202,
      "body": {
        "accepted": true,
        "fr_id": "FR-DOCS-003",
        "production_deploy": "mocked",
        "approved_quote_count": 0,
        "publication_state": "repo-rendered",
        "observability_key": "FR-DOCS-003:launch-blog:mock-deploy"
      }
    }
  }
}
