      "docs/internal/landing/blog/launch-2026.html",
      "docs/internal/landing/blog/launch-2026/index.html"
    ]
  },
  "required_terms": [
    "DSAF",
    "Design System Audit Framework",
    "DSAF Criteria",
    "DSAF-25 Core",
    "DSAF Levels",
    "DSAF Modes",
    "SCAN mode",
    "FIX mode",
    "W mode"
