  "banned_patterns": [
    "\\b(the )?DSAF Framework\\b",
    "\\bDSAF framework\\b",
    "\\bthe Framework\\b",
    "CyberSkill'?s framework",
    "CyberSkill framework",
    "#DesignSystemAuditFramework",
    "#dsafFramework",
    "#dsaf25",
    "#dsafCore"
