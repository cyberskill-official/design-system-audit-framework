  "required_readme_h1": "# DSAF — Design System Audit Framework",
  "minimum_dsaf_mentions": {
    "README.md": 5,
    "docs/internal/branding/handle-taxonomy.md": 5,
    "docs/internal/branding/glossary.md": 5
  }
}
