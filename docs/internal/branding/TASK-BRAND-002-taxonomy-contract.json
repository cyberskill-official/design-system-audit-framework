  "scan": {
    "roots": [
      "README.md",
      "docs/guidelines/CONTRIBUTING.md",
      "docs/internal/SERVICES.md",
      "docs",
      "docs/internal/landing",
      "docs/guidelines/prompts",
      "docs/framework/templates"
    ],
    "extensions": [".md", ".html"],
    "exclude_path_contains": [
      "docs/internal/tasks/",
      "docs/Design System Audit Framework",
      "docs/internal/branding/handle-taxonomy.md",
      "docs/internal/branding/glossary.md",
      "docs/internal/branding/brand-audit-2026-05-18.md",
