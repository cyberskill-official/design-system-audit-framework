{
  "schema_version": "2026-05-18",
  "fr_id": "TASK-CORE-001",
  "status": "strict-audit-contract",
  "observability": {
    "audit_output": "outputs/_audit/dsaf-25-contract.json",
    "correlation_key": "fr_id + artifact + criterion_id + rule_id",
    "events": [
      "core_subset_parsed",
      "source_rubric_loaded",
      "artifact_checked",
      "manual_validation_mock_checked",
      "strict_audit_recorded"
    ]
  },
  "edge_case_matrix": [
    {
      "case": "null_or_missing_artifact",
      "risk": "A referenced Core artefact is absent or empty.",
      "expected": "Fail with the missing artifact path."
    },
    {
      "case": "duplicate_or_missing_core_id",
      "risk": "The card silently has fewer or more than 25 unique rows.",
      "expected": "Fail exact-order and uniqueness checks."
    },
    {
      "case": "category_coverage_gap",
      "risk": "One Part A or Part B category disappears from the one-page subset.",
      "expected": "Fail the category coverage rule for every missing prefix."
    },
    {
      "case": "verbatim_drift",
      "risk": "DSAF-25 rewords a full-rubric criterion and becomes a parallel rubric.",
      "expected": "Fail criterion-name and tag comparison against DSAF-125 source rows."
    },
    {
      "case": "malformed_score_contract",
      "risk": "Audit reports cannot distinguish DSAF-25 from DSAF-125 scores.",
      "expected": "Fail if `dsaf_25_score` or the sum-divided-by-125 formula disappears."
    },
    {
      "case": "non_inline_public_card",
      "risk": "The public card hides the criteria from screen readers and crawlers.",
      "expected": "Fail if `/card` uses an external image instead of inline SVG text."
    },
    {
      "case": "print_extremes",
      "risk": "The printable asset is missing, huge, or not sheet-sized.",
      "expected": "Fail SVG/PDF existence, size, title, desc, and viewBox checks."
    },
    {
      "case": "human_trial_unavailable",
      "risk": "Five-minute designer read and PM recall trials require named humans.",
      "expected": "Mark as mocked only when the request/response shape is complete."
    }
  ],
