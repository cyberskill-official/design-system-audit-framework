      "fr_id",
      "trial_id",
      "reviewer_role",
      "asset",
      "viewport",
      "identified_subject",
      "result"
    ],
    "allowed_results": ["pass", "partial-pass"],
    "mock_requests": [
      {
        "fr_id": "FR-BRAND-003",
        "trial_id": "mock-ladder-designer",
        "reviewer_role": "designer",
        "asset": "framework/assets/dsaf-l0-l5-ladder.svg",
        "viewport": "1200x675",
        "identified_subject": "DSAF L0-L5 maturity ladder",
        "result": "pass"
      },
      {
        "fr_id": "FR-BRAND-003",
