        "reviewer_role": "engineering_lead",
        "asset": "framework/assets/dsaf-radar.svg",
        "viewport": "1200x675",
        "identified_subject": "DSAF 20-axis radar chart",
        "result": "pass"
      },
      {
        "fr_id": "FR-BRAND-003",
        "trial_id": "mock-ladder-pm",
