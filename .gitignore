# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/
dist-*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Project specific
docs/outputs/
outputs/
patch-contracts.cjs

# Tool-generated directories
.code-review-graph/
.playwright-cli/

# AI-generated temporary benchmark scripts and outputs
benchmark-*.js
benchmark-*.mjs
benchmark-*.cjs
benchmark-*.ts
*bench*.mjs
*bench*.cjs
temp-*.js
temp-*.mjs
temp-*.cjs
temp-*.ts
scratch/
.dsaf-cache.json

# Workspace dist folders (build artifacts)
packages/cli/dist/
packages/figma-plugin/dist/
packages/github-action/dist/

# Generated blog HTML (built by render-blog.mjs at build time)
apps/landing/blog/**/*.html

# VSCode settings (auto-generated by supabase init — developer-specific)
.vscode/

# Agent sandbox scratch artifacts (the Cowork sandbox cannot unlink mount files,
# so probe/test files it creates must be removed manually on macOS — ignore them
# here so a stray `git add -A` never commits them). Safe to `rm -rf` locally.
__rmtest__*
__rmtestdir__/

# CyberOS vendored machine + local BRAIN at .cyberos/memory/store (regenerable via init; tenant data). Do not commit.
.cyberos/
